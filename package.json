{
	"private": true,
	"main": "pause-control.mjs",
	"engines": {
		"node": ">=16.0.0"
	},
	"devDependencies": {
		"@babel/eslint-parser": "^7.17.0",
		"@league-of-foundry-developers/foundry-vtt-types": "^9.249.4",
		"esbuild": "^0.14.48",
		"eslint": "^8.11.0",
		"eslint-plugin-optimize-regex": "^1.2.1",
		"lint-staged": "^13.0.3",
		"prettier": "^2.7.1"
	},
	"lint-staged": {
		"*.mjs": "eslint --cache --fix",
		"*.json": "prettier --write",
		"*.scss": "prettier --write"
	},
	"scripts": {
		"release": "node ./scripts/release.mjs",
		"build": "node ./scripts/esbuild.mjs",
		"build:watch": "node ./scripts/esbuild.mjs --watch",
		"lint:js": "set TIMING=1 && npx eslint . --ext js,mjs --cache",
		"lint:js:fix": "npx eslint . --ext js,mjs --cache --fix"
	}
}
